
### Variable de servidor - Cambiar entre localhost y producción
@baseUrl = http://obi.trarocrm.cl/obi/api/schedules/v1/
# @baseUrl = https://api.produccion.com/api

### ============================================
### SCHEDULE ENDPOINTS
### ============================================

### Listar todas las programaciones
GET {{baseUrl}}/schedules
Accept: application/json
x-internal-key: obi2025

### Obtener una programación por ID
GET {{baseUrl}}/schedules/1
Accept: application/json
x-internal-key: obi2025

### Crear una programación
POST {{baseUrl}}/schedules
Content-Type: application/json
x-internal-key: obi2025

{
    "case_id": 1,
    "consultant_id": 1,
    "loss_adjuster_id": 1,
    "inspection_date": "2025-04-01",
    "inspection_time": "10:30",
    "comments": "Programación inicial"
}

### Actualizar una programación (PUT)
PUT {{baseUrl}}/schedules/1
Content-Type: application/json
x-internal-key: obi2025

{
    "case_id": 1,
    "consultant_id": 2,
    "loss_adjuster_id": 1,
    "inspection_date": "2025-04-02",
    "inspection_time": "14:00",
    "comments": "Programación actualizada"
}

### Actualización parcial de una programación (PATCH)
PATCH {{baseUrl}}/schedules/1
Content-Type: application/json
x-internal-key: obi2025

{
    "inspection_time": "15:30"
}

### Eliminar una programación
DELETE {{baseUrl}}/schedules/1
x-internal-key: obi2025

### Listar programaciones por caso
GET {{baseUrl}}/schedule/1
Accept: application/json
x-internal-key: obi2025

### Crear o reprogramar
POST {{baseUrl}}/schedule/1
Content-Type: application/json
x-internal-key: obi2025

{
    "inspection_date": "2025-04-03",
    "inspection_time": "09:00",
    "consultant_id": 1,
    "is_reprogramming": false
}

### Actualizar programación vigente
PATCH {{baseUrl}}/schedule/1
Content-Type: application/json
x-internal-key: obi2025

{
    "inspection_date": "2025-04-04",
    "inspection_time": "11:00"
}

### ============================================
### SCHEDULE STATUS ENDPOINTS
### ============================================

### Listar todos los estados
GET {{baseUrl}}/schedule-statuses
Accept: application/json
x-internal-key: obi2025

### Obtener un estado por ID
GET {{baseUrl}}/schedule-statuses/1
Accept: application/json
x-internal-key: obi2025

### Crear un estado
POST {{baseUrl}}/schedule-statuses
Content-Type: application/json
x-internal-key: obi2025

{
    "name": "Pendiente"
}

### Actualizar un estado (PUT)
PUT {{baseUrl}}/schedule-statuses/1
Content-Type: application/json
x-internal-key: obi2025

{
    "name": "En Proceso"
}

### Actualización parcial de un estado (PATCH)
PATCH {{baseUrl}}/schedule-statuses/1
Content-Type: application/json
x-internal-key: obi2025

{
    "name": "Completado"
}

### Eliminar un estado
DELETE {{baseUrl}}/schedule-statuses/1
x-internal-key: obi2025

### ============================================
### DISPATCH ENDPOINTS
### ============================================

### Listar todos los despachos
GET {{baseUrl}}/dispatches
Accept: application/json
x-internal-key: obi2025

### Obtener un despacho por ID
GET {{baseUrl}}/dispatches/1
Accept: application/json
x-internal-key: obi2025

### Crear un despacho
POST {{baseUrl}}/dispatches
Content-Type: application/json
x-internal-key: obi2025

{
    "date": "2025-04-01",
    "assistant_id": 1
}

### Actualizar un despacho (PUT)
PUT {{baseUrl}}/dispatches/1
Content-Type: application/json
x-internal-key: obi2025

{
    "date": "2025-04-02",
    "assistant_id": 2
}

### Actualización parcial de un despacho (PATCH)
PATCH {{baseUrl}}/dispatches/1
Content-Type: application/json
x-internal-key: obi2025

{
    "date": "2025-04-03",
    "assistant_id": 3
}

### Eliminar un despacho
DELETE {{baseUrl}}/dispatches/1
x-internal-key: obi2025

### Listar despachos por fecha
GET {{baseUrl}}/dispatches/date/2025-04-01
Accept: application/json
x-internal-key: obi2025

### Obtener despacho con sus detalles
GET {{baseUrl}}/dispatches/1/details
Accept: application/json
x-internal-key: obi2025

### ============================================
### DISPATCH DETAIL ENDPOINTS
### ============================================

### Listar todos los detalles de despacho
GET {{baseUrl}}/dispatch-details
Accept: application/json
x-internal-key: obi2025

### Obtener un detalle de despacho por ID
GET {{baseUrl}}/dispatch-details/1
Accept: application/json
x-internal-key: obi2025

### Crear un detalle de despacho
POST {{baseUrl}}/dispatch-details
Content-Type: application/json
x-internal-key: obi2025

{
    "dispatch_id": 1,
    "movement_type_id": 1,
    "cases": "Caso de prueba",
    "origin": 1,
    "destination": 2,
    "km_traveled": 150,
    "fare_value": 50000,
    "comments": "Detalle de despacho de prueba"
}

### Actualizar un detalle de despacho (PUT)
PUT {{baseUrl}}/dispatch-details/1
Content-Type: application/json
x-internal-key: obi2025

{
    "dispatch_id": 1,
    "movement_type_id": 2,
    "cases": "Caso actualizado",
    "origin": 2,
    "destination": 3,
    "km_traveled": 200,
    "fare_value": 75000,
    "comments": "Detalle actualizado"
}

### Actualización parcial de un detalle de despacho (PATCH)
PATCH {{baseUrl}}/dispatch-details/1
Content-Type: application/json
x-internal-key: obi2025

{
    "km_traveled": 250,
    "fare_value": 80000
}

### Eliminar un detalle de despacho
DELETE {{baseUrl}}/dispatch-details/1
x-internal-key: obi2025

### Listar detalles por despacho
GET {{baseUrl}}/dispatch-details/dispatch/1
Accept: application/json
x-internal-key: obi2025

### Obtener detalle con su tipo de movimiento
GET {{baseUrl}}/dispatch-details/1/movement-type
Accept: application/json
x-internal-key: obi2025

